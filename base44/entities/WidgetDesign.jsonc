{
  "name": "WidgetDesign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the desktop widget design"
    },
    "config": {
      "type": "object",
      "description": "Readings, layout, style and placement settings of the design"
    },
    "readings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids of the readings the design shows"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}